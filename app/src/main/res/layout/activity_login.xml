<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_premium"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_24"
        android:paddingTop="@dimen/dp_56"
        android:paddingBottom="@dimen/dp_40">

        <!-- BBSBEC Official Logo / Emblem using splash.webp -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="108dp"
            android:layout_height="108dp"
            app:cardCornerRadius="54dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/all_white"
            app:strokeColor="@color/border"
            app:strokeWidth="1.5dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/dp_12"
                android:scaleType="fitCenter"
                android:src="@drawable/splash" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Title & Badge -->
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/outfit"
            android:text="BBSBEC ERP"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            app:cardBackgroundColor="@color/surface2"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="UNOFFICIAL STUDENT PORTAL"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_24">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="Student Sign In"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Enter your BBSBEC Web ERP credentials to automatically sync your profile, attendance, and timetable."
                    android:textColor="@color/text_dim"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:textSize="13sp" />

                <!-- Email / Username Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:hint="Portal Email"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/accent"
                    app:hintTextColor="@color/accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingVertical="@dimen/dp_14"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:hint="Portal Password"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/accent"
                    app:hintTextColor="@color/accent"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_dim">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingVertical="@dimen/dp_14"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sign In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/dp_22"
                    android:backgroundTint="@color/accent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Sign In &amp; Sync ERP"
                    android:textAllCaps="false"
                    android:textColor="@color/all_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <!-- Progress indicator -->
                <ProgressBar
                    android:id="@+id/loginProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dp_14"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <!-- Error text -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Invalid credentials" />

                <!-- Forgot Password -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/forgotPasswordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dp_16"
                    android:padding="@dimen/dp_6"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Forgot Password? Open Web ERP Portal"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security / College reassurance footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Baba Banda Singh Bahadur Engineering College"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:gravity="center"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Made with love with ❤️ by rasid"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
