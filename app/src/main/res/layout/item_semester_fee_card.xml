<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_14"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="@dimen/dp_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_16">

        <!-- Header: Semester Title & Part Paid Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/semesterTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                tools:text="Semester 5" />

            <!-- Status Badge (e.g. Part paid / Paid / Pending) -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/semesterStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/surface2_card_background"
                android:backgroundTint="#FEF3C7"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:textColor="#B45309"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                tools:text="Part paid" />
        </LinearLayout>

        <!-- Divider below header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_10"
            android:background="@color/border" />

        <!-- Line items table container -->
        <LinearLayout
            android:id="@+id/lineItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item 1: Tuition Fee -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_4"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem1Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    tools:text="Tuition Fee *" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem1Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    tools:text="₹45,000" />
            </LinearLayout>

            <!-- Item 2: Hostel Fee (Non-AC) -->
            <LinearLayout
                android:id="@+id/lineItem2Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_4"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem2Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    tools:text="Hostel Fee (Non-AC)" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem2Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    tools:text="₹9,000" />
            </LinearLayout>

            <!-- Item 3: Hostel Fee (AC) -->
            <LinearLayout
                android:id="@+id/lineItem3Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_4"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem3Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    tools:text="Hostel Fee (AC)" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lineItem3Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    tools:text="₹15,000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider above summary -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_8"
            android:background="@color/border" />

        <!-- Net Payable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_2"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Net payable"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/netPayableText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                tools:text="₹69,000" />
        </LinearLayout>

        <!-- Paid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_2"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Paid"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/paidAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                tools:text="₹0" />
        </LinearLayout>

        <!-- Outstanding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Outstanding:"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/outstandingAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                tools:text="₹69,000" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
