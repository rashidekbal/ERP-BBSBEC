<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/dp_14"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="@dimen/dp_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_14">

        <!-- Header: Category & Timestamp & Unread Dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/unreadDot"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:background="@drawable/dot_shape"
                android:backgroundTint="#4F46E5" />

            <!-- Category Badge -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/categoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/surface2_card_background"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_3"
                android:textColor="#4F46E5"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                tools:text="Academic" />

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_weight="1" />

            <!-- Time text -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/timestampText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_11"
                tools:text="10 Oct, 02:20 PM" />

        </LinearLayout>

        <!-- Notification Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            tools:text="MST-1 Schedule Announced" />

        <!-- Notification Message snippet -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/messageSnippetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:lineSpacingExtra="@dimen/dp_2"
            android:maxLines="2"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_13"
            tools:text="Mid-semester test schedule for 7th semester has been uploaded." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
