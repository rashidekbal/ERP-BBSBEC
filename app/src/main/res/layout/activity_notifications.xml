<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginBottom="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_15">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/arrow_left"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Notifications"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/unreadCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/surface2_card_background"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_2"
                android:textColor="#4F46E5"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3 new"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Mark all as read button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/markAllReadBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_12">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_check"
                    app:tint="#4F46E5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Read all"
                    android:textColor="#4F46E5"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingVertical="@dimen/dp_6"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Filter: All -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filterAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:layout_marginEnd="@dimen/dp_8"
                app:cardBackgroundColor="#4F46E5"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterAllText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:text="All"
                    android:textColor="@color/all_white"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter: Academic -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filterAcademicBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:layout_marginEnd="@dimen/dp_8"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterAcademicText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:text="Academic"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter: General -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filterGeneralBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:layout_marginEnd="@dimen/dp_8"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterGeneralText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:text="General"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter: Fees -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filterFeesBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:layout_marginEnd="@dimen/dp_8"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterFeesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:text="Fees"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content area with SwipeRefresh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_30"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:src="@drawable/ic_notification"
                app:tint="@color/text_dim" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="No Notifications Yet"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="You're all caught up with your college announcements and alerts."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_13" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notificationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_30"
                tools:itemCount="3"
                tools:listitem="@layout/item_notification_card" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

</LinearLayout>
