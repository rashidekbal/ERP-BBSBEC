<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_15"
    tools:context=".screens.terms.TermsActivity">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_8"
                android:src="@drawable/arrow_left" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/outfit"
            android:text="@string/terms_and_conditions"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dp_15"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_30">

            <!-- Highlight Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_18">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="Terms &amp; Service Agreement"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="By accessing or using Attend, you agree to comply with these terms, conditions, and our privacy practices. Please review them carefully."
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_14" />
            </LinearLayout>

            <!-- Card 1: Acceptance of Terms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Acceptance &amp; Eligibility"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="Attend is designed as a personal student companion for scheduling, attendance tracking, and academic performance analysis. By initializing setup and tapping 'Agree &amp; Continue', you confirm that you accept these terms and agree to use the application in accordance with all applicable educational and legal policies."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <!-- Card 2: Data Collection & Advertising -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Data Collection Disclosure &amp; Ads"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="BBSBEC-ERP Premium Edition is built for privacy and performance. The application contains zero advertising, zero external telemetry, and zero third-party diagnostic tracking.\n\nPersonal student credentials, timetable schedules, internal marks, and attendance logs are stored locally on your device."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <!-- Card 3: Permitted Use & Academic Responsibility -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Permitted Use &amp; Calculations"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="Attendance calculations, risk warnings, and safe-to-bunk margins provided in Attend are mathematical estimates calculated based on your personal inputs. They are provided solely for convenience and reference. Official attendance figures recorded by your college or university administration always take absolute precedence."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <!-- Card 4: Data Ownership & Storage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Data Ownership &amp; Backups"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="You retain total ownership of all academic records stored in the application. Attend provides built-in JSON backup export and import functions so you can secure your records. We do not provide cloud backup storage for your timetable and marks."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <!-- Card 5: Developer Portfolio & Support -->
            <LinearLayout
                android:id="@+id/portfolioCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5. Developer Portfolio &amp; Inquiries"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:rotation="180"
                        android:src="@drawable/greater_than"
                        app:tint="@color/accent" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="Attend is engineered and maintained by Rasid Ekbal (R-technologies). To inspect projects, terms, privacy updates, or connect with the author, tap to visit the developer portfolio at https://rasidekbal.in."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="🔗 Visit rasidekbal.in"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 6: Changes to Terms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="6. Modifications"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="We reserve the right to revise these Terms &amp; Conditions periodically to reflect application features or regulatory requirements. Continued use of Attend signifies acceptance of any updated terms."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
