<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    tools:context=".screens.timeTable.TimeTableActivity">

    <!-- ══════════════════════════════════════════════
         TOP HEADER BAR — 1:1 Web Mockup
         ══════════════════════════════════════════════ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_8"
                android:src="@drawable/arrow_left" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
            android:text="Master Timetable"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <!-- Edit Slots Action Button -->
        <Button
            android:id="@+id/editSlotsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
            android:text="Edit Slots"
            android:textColor="@color/accent"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_40">

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="Weekly Schedule Grid (5-Day Working Week)"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_13" />

            <!-- Day Selector Filter Bar (1:1 Web Mockup) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/dayChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMonday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Mon"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/surface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTuesday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tue"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/surface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWednesday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wed"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/surface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipThursday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thu"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/surface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFriday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fri"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/surface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSaturday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sat"
                        android:textColor="@color/text"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/surface"
                        tools:visibility="visible" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Top Summary Configuration Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Period Length Card -->
                    <LinearLayout
                        android:id="@+id/periodLengthCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/period_length"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/periodLengthMinusBtn"
                                android:layout_width="@dimen/dp_24"
                                android:layout_height="@dimen/dp_24"
                                android:clickable="false"
                                android:focusable="false"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/surface2"
                                app:cardCornerRadius="@dimen/dp_6"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/dp_5"
                                    android:src="@drawable/minus"
                                    app:tint="@color/text" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/periodDurationText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_50_mins"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/periodLengthPlusBtn"
                                android:layout_width="@dimen/dp_24"
                                android:layout_height="@dimen/dp_24"
                                android:clickable="false"
                                android:focusable="false"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/surface2"
                                app:cardCornerRadius="@dimen/dp_6"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/dp_5"
                                    android:src="@drawable/plus"
                                    app:tint="@color/text" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Periods / Day Card -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_14"
                        android:paddingVertical="@dimen/dp_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periods_day"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/periodsPerDayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/_9_slots"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Working Days Card -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_14"
                        android:paddingVertical="@dimen/dp_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/working_days"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/workingDaysText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/_5_days"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- First Class Time Card -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_14"
                        android:paddingVertical="@dimen/dp_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/first_class"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/firstClassTimeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/_09_00_am"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>


            <!-- Day Header & Class Count Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_10"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectedDayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/monday_schedule"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selectedDayClassCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/surface2_card_background"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_4"
                    android:text="@string/_4_classes"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Period Slots RecyclerView (Class Cards) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPeriods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_timetable_period" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_16"
                android:background="@drawable/surface_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/dp_20"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_schedule_for_this_day"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/add_subjects_or_assign_periods_above"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <!-- Weekly Subject Allocation Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/subject_allocation"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalWeeklyClassesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_18_slots_wk"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:paddingVertical="@dimen/dp_10">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSubjectSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_timetable_subject_summary" />

                    <TextView
                        android:id="@+id/emptySubjectsSummaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/dp_10"
                        android:text="@string/no_subjects_added_yet"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_12"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
