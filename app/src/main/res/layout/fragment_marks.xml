<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    tools:context=".screens.home.pages.marks.MarksFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/dp_42">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_80">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sideBar_btn"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:strokeColor="@color/border"
                    app:strokeWidth="@dimen/dp_1">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/dp_35"
                        android:layout_height="@dimen/dp_35"
                        android:layout_gravity="center"
                        android:padding="@dimen/dp_10"
                        android:src="@drawable/side_menu" />
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/marks_1"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_26"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/mid_sem_performance_across_subjects"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_13" />

            <!-- Mode Switcher: All Subjects Table vs Compare 3 Terms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/surface2_card_background"
                android:orientation="horizontal"
                android:padding="@dimen/dp_4">

                <!-- Table Mode Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/modeTableBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:cardElevation="@dimen/dp_2"
                    app:strokeColor="@color/border"
                    app:strokeWidth="@dimen/dp_1">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/modeTableText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="@dimen/dp_10"
                        android:text="All Subjects Table"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Compare Mode Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/modeCompareBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:cardElevation="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/modeCompareText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="@dimen/dp_10"
                        android:text="Compare 3 Terms"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="normal" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════
                 VIEW CONTAINER 1: ALL SUBJECTS TABLE MODE
                 ══════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/marksTableViewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- 3 Averages Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_4"
                        android:layout_weight="1"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_16">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/mid1_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            tools:text="62.5%" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mid_sem_1_avg"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_4"
                        android:layout_weight="1"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_16">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/mid2_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            tools:text="—" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mid_sem_2_avg"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_weight="1"
                        android:background="@drawable/surface_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_16">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/mid3_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            tools:text="—" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mid_sem_3_avg"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>
                </LinearLayout>


                <!-- All Subjects Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/all_subjects"
                        android:textColor="@color/text"
                        android:textFontWeight="600"
                        android:textSize="@dimen/sp_15" />

                    <Button
                        android:id="@+id/addSubjectBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:text="@string/add_marks_1"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/sp_14"
                        android:visibility="gone" />
                </RelativeLayout>

                <!-- Table Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_15">

                    <LinearLayout
                        android:id="@+id/marksTableHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:background="@drawable/bottom_border"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/dp_14"
                        android:weightSum="10">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:gravity="center_vertical|start"
                            android:text="@string/subject_1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="@string/mid_1"
                            android:textAlignment="center"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="@string/mid_2"
                            android:textAlignment="center"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="@string/mid_3"
                            android:textAlignment="center"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/marksRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/marks_card_rv" />

                    <!-- Empty State for Marks -->
                    <LinearLayout
                        android:id="@+id/emptyMarksLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dp_20"
                        android:paddingVertical="@dimen/dp_20"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/emptyMarksIcon"
                            android:layout_width="@dimen/dp_64"
                            android:layout_height="@dimen/dp_64"
                            android:src="@drawable/ic_empty_marks" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                            android:text="@string/no_marks_recorded_yet"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_15" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:gravity="center"
                            android:text="@string/add_your_mid_term_scores_to_calculate_cl"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Trend Insight Card -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/trend"
                    android:textColor="@color/text"
                    android:textFontWeight="600"
                    android:textSize="@dimen/sp_15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/marks_trend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_13"
                        tools:text="Computer Networks improved the most between Mid Sem 1 and Mid Sem 2." />
                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════
                 VIEW CONTAINER 2: MULTI-TERM COMPARE MODE (1:1)
                 ══════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/marksCompareViewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Subject Selector Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/compareSubjectSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_44"
                        android:background="@drawable/spinner_box_bg_surface"
                        android:dropDownVerticalOffset="@dimen/dp_6"
                        android:paddingHorizontal="@dimen/dp_14"
                        android:popupBackground="@drawable/spinner_popup_background" />
                </LinearLayout>

                <!-- Modern Multi-Term Graph Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_16">

                    <!-- Graph Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/compareSubjectTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_15"
                                android:textStyle="bold"
                                tools:text="Database Management Systems" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="Score progression across Mid Sem 1, 2, and 3"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <!-- Growth Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/growthBadgeCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            app:cardBackgroundColor="@color/surface2"
                            app:cardCornerRadius="@dimen/dp_12"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/growthBadgeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/dp_10"
                                android:layout_marginVertical="@dimen/dp_4"
                                android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/success"
                                android:textSize="@dimen/sp_11"
                                android:textStyle="bold"
                                tools:text="+50% Growth" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <!-- Custom Curve Graph View -->
                    <com.redcodersgroup.attend_collegeattendancetracker.screens.home.pages.marks.view.MultiTermGraphView
                        android:id="@+id/multiTermGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_160"
                        android:layout_marginTop="@dimen/dp_12" />
                </LinearLayout>

                <!-- Term Score Bars Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Term Breakdown &amp; Comparison"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold" />

                    <!-- Mid 1 Bar Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dp_70"
                            android:layout_height="wrap_content"
                            android:text="Mid Sem 1"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/term1Progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/dp_10"
                            android:progress="0"
                            tools:progress="42"
                            app:trackCornerRadius="@dimen/dp_5"
                            app:trackThickness="@dimen/dp_8"
                            app:trackColor="@color/surface2"
                            app:indicatorColor="@color/accent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/term1ScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            tools:text="10/24 (42%)" />
                    </LinearLayout>

                    <!-- Mid 2 Bar Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dp_70"
                            android:layout_height="wrap_content"
                            android:text="Mid Sem 2"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/term2Progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/dp_10"
                            android:progress="0"
                            tools:progress="67"
                            app:trackCornerRadius="@dimen/dp_5"
                            app:trackThickness="@dimen/dp_8"
                            app:trackColor="@color/surface2"
                            app:indicatorColor="@color/accent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/term2ScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            tools:text="16/24 (67%)" />
                    </LinearLayout>

                    <!-- Mid 3 Bar Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dp_70"
                            android:layout_height="wrap_content"
                            android:text="Mid Sem 3"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/term3Progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/dp_10"
                            android:progress="0"
                            tools:progress="92"
                            app:trackCornerRadius="@dimen/dp_5"
                            app:trackThickness="@dimen/dp_8"
                            app:trackColor="@color/surface2"
                            app:indicatorColor="@color/success" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/term3ScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/success"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            tools:text="22/24 (92%)" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Comparison Insight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/compareInsightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_13"
                        tools:text="Highest improvement: +50% from Mid Sem 1 to Mid Sem 3." />
                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
