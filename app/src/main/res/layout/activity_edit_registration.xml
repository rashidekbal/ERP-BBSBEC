<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginBottom="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_15">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/arrow_left"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Edit Registration"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_30">

            <!-- Subtitle -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/editingSemesterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_16"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Editing semester 5"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_13" />

            <!-- 1. Fees paid amount -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Fees paid amount"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/feesPaidInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="@drawable/bg_rounded_input_field"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="65000"
                android:inputType="number"
                android:paddingHorizontal="@dimen/dp_14"
                android:text="65000"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="@dimen/sp_14" />

            <!-- 2. Scholarship received amount -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Scholarship received amount"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/scholarshipReceivedInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="@drawable/bg_rounded_input_field"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="0"
                android:inputType="number"
                android:paddingHorizontal="@dimen/dp_14"
                android:text="0"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="@dimen/sp_14" />

            <!-- 3. Scholarship applied -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Scholarship applied"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/scholarshipAppliedInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="@drawable/bg_rounded_input_field"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="0"
                android:inputType="number"
                android:paddingHorizontal="@dimen/dp_14"
                android:text="0"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="@dimen/sp_14" />

            <!-- 4. Registration code -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Registration code"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/registrationCodeInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_16"
                android:background="@drawable/bg_rounded_input_field"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="842988"
                android:inputType="text"
                android:paddingHorizontal="@dimen/dp_14"
                android:text="842988"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="@dimen/sp_14" />

            <!-- Section Title: Select subjects -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Select subjects"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />

            <!-- Selectable Subjects RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subjectsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_selectable_subject" />

            <!-- Update registration Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateRegistrationBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_20"
                android:backgroundTint="#4F46E5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Update registration"
                android:textAllCaps="false"
                android:textColor="@color/all_white"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                app:cornerRadius="@dimen/dp_12" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
