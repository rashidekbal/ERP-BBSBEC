<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginBottom="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_15">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/arrow_left"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Fees"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/refreshBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_refresh"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Main Content with Swipe Refresh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/dp_15"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dp_80">

                    <!-- 1. Top Card: Net fees Hero Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="@dimen/dp_1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_18">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Net fees"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_13" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/netFeesTotalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="₹3,45,000"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_28"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_14"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="PAID"
                                        android:textColor="@color/text_dim"
                                        android:textSize="@dimen/sp_11"
                                        android:textStyle="bold" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/paidTotalText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="₹0"
                                        android:textColor="@color/success"
                                        android:textSize="@dimen/sp_16"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="OUTSTANDING"
                                        android:textColor="@color/text_dim"
                                        android:textSize="@dimen/sp_11"
                                        android:textStyle="bold" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/outstandingTotalText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="₹3,45,000"
                                        android:textColor="#B45309"
                                        android:textSize="@dimen/sp_16"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 2. Balance due Warning Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        app:cardBackgroundColor="#FFFBEB"
                        app:cardCornerRadius="@dimen/dp_14"
                        app:cardElevation="0dp"
                        app:strokeColor="#FDE68A"
                        app:strokeWidth="@dimen/dp_1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_14">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Balance due"
                                android:textColor="#92400E"
                                android:textSize="@dimen/sp_14"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:lineSpacingExtra="@dimen/dp_2"
                                android:text="Pending payments are not included in the paid total until verified by the college."
                                android:textColor="#78350F"
                                android:textSize="@dimen/sp_12" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. Section Header: Semester records & Pagination -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Semester records"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/recordsCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="1 of 1"
                            android:textColor="#4F46E5"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:text="Fee records by semester, line items and how much is paid. This module is under development — records below may not be accurate; please ignore any discrepancy."
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_12" />

                    <!-- Per Page Pagination Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_8"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Per page"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="@dimen/dp_8"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/dp_16"
                            app:cardElevation="0dp"
                            app:strokeColor="#4F46E5"
                            app:strokeWidth="@dimen/dp_1">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="20"
                                android:textColor="#4F46E5"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="@dimen/dp_8"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/dp_16"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="@dimen/dp_1">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="50"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_12" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_34"
                            android:layout_height="@dimen/dp_32"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/dp_16"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="@dimen/dp_1">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="100"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- 4. Semester Fee Records RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/semesterRecordsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_semester_fee_card" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Bottom Action Button for Submit Payment -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_sheet_bg"
            android:paddingHorizontal="@dimen/dp_15"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSubmitPaymentBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:backgroundTint="#4F46E5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Submit Payment"
                android:textAllCaps="false"
                android:textColor="@color/all_white"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                app:cornerRadius="@dimen/dp_12"
                app:icon="@drawable/ic_payments"
                app:iconGravity="textStart"
                app:iconTint="@color/all_white" />
        </FrameLayout>

    </FrameLayout>
</LinearLayout>
