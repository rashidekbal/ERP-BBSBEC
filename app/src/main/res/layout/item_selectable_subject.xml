<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subjectCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#F8F9FE"
    app:cardCornerRadius="@dimen/dp_14"
    app:cardElevation="0dp"
    app:strokeColor="#C7D2FE"
    app:strokeWidth="@dimen/dp_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_14"
        android:paddingVertical="@dimen/dp_12">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/subjectCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:buttonTint="#4F46E5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/subjectTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                tools:text="Database Management Systems (DBMS)" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/subjectSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12"
                tools:text="BTCS501-18 · theory · 3 credits" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
