<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".screens.analytics.AnalyticsActivity">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginBottom="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_15">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/arrow_left"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_14"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Attendance Analytics"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Trends, streaks &amp; safe margins"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/refreshBtn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/dp_1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:src="@drawable/ic_analytics"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_15"
            android:paddingBottom="@dimen/dp_50">

            <!-- 1. Hero Overall Attendance Gauge Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_16">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/overallProgressIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="0"
                            tools:progress="75"
                            app:indicatorColor="@color/accent"
                            app:indicatorSize="@dimen/dp_110"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:trackColor="@color/accent_dim"
                            app:trackCornerRadius="@dimen/dp_3"
                            app:trackThickness="@dimen/dp_10" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="@id/overallProgressIndicator"
                            app:layout_constraintEnd_toEndOf="@id/overallProgressIndicator"
                            app:layout_constraintStart_toStartOf="@id/overallProgressIndicator"
                            app:layout_constraintTop_toTopOf="@id/overallProgressIndicator">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/overallPercentageText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_22"
                                android:textStyle="bold"
                                tools:text="82%" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Overall"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_16"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="@id/overallProgressIndicator"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/overallProgressIndicator"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/overallStatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/accent_dim"
                                app:cardCornerRadius="@dimen/dp_6"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/overallStatusChipText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:paddingHorizontal="@dimen/dp_8"
                                    android:paddingVertical="@dimen/dp_3"
                                    android:textColor="@color/accent"
                                    android:textSize="@dimen/sp_11"
                                    android:textStyle="bold"
                                    tools:text="Safe Margin" />
                            </com.google.android.material.card.MaterialCardView>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/heroBunkHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold"
                                tools:text="Can safely skip 5 classes" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/targetCriteriaNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_12"
                                tools:text="Target: 75% (+7% margin)" />

                            <!-- Consecutive Streak Badge -->
                            <LinearLayout
                                android:id="@+id/streakContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/streakIcon"
                                    android:layout_width="@dimen/dp_13"
                                    android:layout_height="@dimen/dp_13"
                                    android:layout_marginEnd="@dimen/dp_4"
                                    android:src="@drawable/ic_streak_bolt"
                                    app:tint="@color/accent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/streakText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="4-Day Streak · Best: 8 Days"
                                    android:textColor="@color/accent"
                                    android:textSize="@dimen/sp_11"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginVertical="@dimen/dp_14"
                        android:background="@color/border" />

                    <!-- 4-Column Stats Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/totalAttendedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold"
                                tools:text="48" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Attended"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/totalConductedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold"
                                tools:text="58" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Conducted"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/totalMissedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/danger"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold"
                                tools:text="10" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Missed"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/totalCancelledText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Attendance Momentum & Velocity (Last 7 Days vs Last 30 Days) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- 7-Day Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/dp_14"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="@dimen/dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Past 7 Days"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/last7DaysPctText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_18"
                                android:textStyle="bold"
                                tools:text="90%" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/velocityIndicatorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_6"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/success"
                                android:textSize="@dimen/sp_11"
                                android:textStyle="bold"
                                tools:text="↗ Improving" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 30-Day Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/dp_14"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="@dimen/dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Past 30 Days"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/last30DaysPctText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:fontFamily="@font/outfit"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            tools:text="82%" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 3. Weekday Attendance Distribution -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:text="Weekday Distribution"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/weekdayInsightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Compare attendance consistency across weekdays"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_12" />

                    <!-- Custom Weekday Distribution Bar View -->
                    <com.redcodersgroup.attend_collegeattendancetracker.screens.analytics.view.WeekdayDistributionView
                        android:id="@+id/weekdayDistributionView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_130"
                        android:layout_marginTop="@dimen/dp_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. What-If Attendance Projection Simulator -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_14">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:text="What-If Bunk Simulator"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Test attending or bunking upcoming sessions"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_12" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resetSimBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reset"
                            android:textAllCaps="false"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <!-- Interactive Controls: Attend Stepper & Bunk Stepper -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Attend Stepper -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_4"
                            android:layout_weight="1"
                            android:background="@drawable/surface_card_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_10">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Attend Next"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/minusAttendBtn"
                                    android:layout_width="@dimen/dp_28"
                                    android:layout_height="@dimen/dp_28"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_minus"
                                    app:tint="@color/text_dim" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/simAttendValueText"
                                    android:layout_width="@dimen/dp_32"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/text"
                                    android:textSize="@dimen/sp_16"
                                    android:textStyle="bold" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/plusAttendBtn"
                                    android:layout_width="@dimen/dp_28"
                                    android:layout_height="@dimen/dp_28"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_fab_plus"
                                    app:tint="@color/success" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Bunk Stepper -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_weight="1"
                            android:background="@drawable/surface_card_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_10">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Bunk Next"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/minusBunkBtn"
                                    android:layout_width="@dimen/dp_28"
                                    android:layout_height="@dimen/dp_28"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_minus"
                                    app:tint="@color/text_dim" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/simBunkValueText"
                                    android:layout_width="@dimen/dp_32"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/text"
                                    android:textSize="@dimen/sp_16"
                                    android:textStyle="bold" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/plusBunkBtn"
                                    android:layout_width="@dimen/dp_28"
                                    android:layout_height="@dimen/dp_28"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_fab_plus"
                                    app:tint="@color/danger" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Simulation Result Output -->
                    <LinearLayout
                        android:id="@+id/simResultCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:background="@drawable/surface_card_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/dp_14"
                        android:paddingVertical="@dimen/dp_10">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/simProjectedPctText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            tools:text="82%" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/simStatusHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="No simulation active"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/simStatusDeltaText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Adjust attendance or bunk counters above"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Subject Risk Matrix & Breakdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"
                    android:text="Subject Health Breakdown"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <!-- Filter Chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterAllBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/dp_6"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="@dimen/dp_1">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/filterAllText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:paddingVertical="@dimen/dp_3"
                            android:text="All"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_11"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterAtRiskBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/dp_6"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="@dimen/dp_1">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/filterAtRiskText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:paddingVertical="@dimen/dp_3"
                            android:text="At Risk (0)"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_11" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Subject Risk RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subjectRiskRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State for Subject Risk -->
            <LinearLayout
                android:id="@+id/emptySubjectsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/ic_empty_attendance"
                    app:tint="@color/text_faint" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="No subjects configured yet"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
