<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingHorizontal="@dimen/dp_20"
    tools:context=".screens.home.pages.sidebar.SideBarFragment">

    <!-- ── Top content block ── -->
    <LinearLayout
        android:id="@+id/sidebarContentBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile header (clickable) -->
        <LinearLayout
            android:id="@+id/profile_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/dp_60"
            android:paddingBottom="@dimen/dp_20"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Avatar circle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileCard"
                android:layout_width="@dimen/dp_52"
                android:layout_height="@dimen/dp_52"
                app:cardCornerRadius="@dimen/dp_50"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/accent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/username_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/all_white"
                    android:textSize="@dimen/sp_16"
                    android:fontFamily="@font/plus_jakarta_sans" app:fontFamily="@font/plus_jakarta_sans"
                    tools:text="RE" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Name / subtitle / link column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    tools:text="Rashid Ekbal" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/userSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13"
                    tools:text="CSE · Sem 6" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/viewProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_13"
                    android:text="@string/view_amp_edit_profile" />

            </LinearLayout>

        </LinearLayout>

        <!-- Section title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="ACADEMIC HUB"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            android:letterSpacing="0.08" />


        <!-- Timetable nav item -->
        <LinearLayout
            android:id="@+id/time_table_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/time_table" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_table"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View your weekly schedule"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Holiday nav item -->
        <LinearLayout
            android:id="@+id/holiday_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/holiday" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/holidays"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming holidays &amp; breaks"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Semester Registration nav item -->
        <LinearLayout
            android:id="@+id/semester_registration_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_registration"
                    app:tint="@color/black" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semester Registration"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course status &amp; subjects"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Fees & Payments nav item -->
        <LinearLayout
            android:id="@+id/fees_payment_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_payments"
                    app:tint="@color/black" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fees &amp; Payments"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fee ledger, dues &amp; receipts"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Webmail / Mailbox nav item -->
        <LinearLayout
            android:id="@+id/webmail_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/black" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus Mailbox"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official student webmail &amp; notices"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Notifications nav item -->
        <LinearLayout
            android:id="@+id/notifications_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/black" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus alerts &amp; announcements"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

        <!-- Settings nav item -->
        <LinearLayout
            android:id="@+id/setting_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/dp_10"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:src="@drawable/setting" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_14">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_15" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferences &amp; app settings"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Version text pinned to bottom ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="@dimen/dp_25"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/attendance_tracker_v1_0_0"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
