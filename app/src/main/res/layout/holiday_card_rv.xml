<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/surface_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_12"
    android:paddingTop="@dimen/dp_15"
    android:layout_marginTop="@dimen/dp_10"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_15"
        android:background="@drawable/bottom_border"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/dp_15"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_weight="3">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/holiday_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/independence_day"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_18" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/holiday_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aug_15_college_closed"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14" />
            </LinearLayout>





        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/options_btn"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:padding="@dimen/dp_5"
                android:rotation="270"
                android:src="@drawable/options_dot"
                android:layout_gravity="center_vertical"
                />
        </LinearLayout>




    </LinearLayout>




</LinearLayout>
