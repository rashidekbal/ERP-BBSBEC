<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/surface_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_20"
    android:paddingTop="@dimen/dp_20"
    android:paddingBottom="@dimen/dp_15">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="@string/terms_and_conditions"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="Please review our terms &amp; data policies"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogCloseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface2"
            app:cardCornerRadius="@dimen/dp_20"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_close"
                app:tint="@color/text" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginVertical="@dimen/dp_12"
        android:background="@color/border" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/termsScrollView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_360"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_10">

            <!-- Highlight Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface2_card_background"
                android:orientation="vertical"
                android:padding="@dimen/dp_12">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Data Transparency"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="Attend is designed as an offline-first college attendance companion. By using the app, you agree to these operational terms and data collection disclosures."
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <!-- 1. Acceptance -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="1. Acceptance &amp; Eligibility"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="By checking the mandatory agreement box and continuing, you confirm that you accept these terms and agree to use Attend in accordance with your university guidelines and applicable policies."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <!-- 2. Data Collection Disclosure -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="2. Data Collection, Telemetry &amp; Advertising"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="BBSBEC-ERP Premium Edition is built for privacy and performance. The application contains zero advertising, zero external telemetry, and zero third-party diagnostic tracking.\n\nYour academic schedules, internal marks, and attendance logs remain strictly on your local device."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <!-- 3. Local Storage -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="3. Offline-First Local Storage"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="All entered student names, timetable schedules, attendance logs, and internal exam marks are stored privately within your device's SQLite database. You have full control to backup or delete your data at any time."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <!-- 4. Calculations Disclaimer -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="4. Calculations &amp; Attendance Disclaimer"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="Safe-to-bunk projections and recovery metrics are estimates calculated from user entries for personal guidance. Official attendance records from your university administration are authoritative."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_12" />

            <!-- 5. Developer Portfolio & Inquiries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/surface2_card_background"
                android:orientation="vertical"
                android:padding="@dimen/dp_10">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. Developer Portfolio &amp; Inquiries"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Developed and maintained by Rasid Ekbal (R-technologies). Portfolio: https://rasidekbal.in"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginVertical="@dimen/dp_12"
        android:background="@color/border" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogDeclineBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Decline"
            android:textColor="@color/text_dim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogAcceptBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:backgroundTint="@color/accent"
            android:text="I Understand &amp; Agree"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/dp_16" />
    </LinearLayout>

</LinearLayout>
