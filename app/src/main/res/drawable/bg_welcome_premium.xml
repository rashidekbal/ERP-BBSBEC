<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid Base Background -->
    <item>
        <color android:color="#F7F6F3" />
    </item>

    <!-- Top Glow: Warm Accent Orb radiating softly from top center -->
    <item
        android:bottom="220dp"
        android:left="-120dp"
        android:right="-120dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.38"
                android:endColor="#00F7F6F3"
                android:gradientRadius="380dp"
                android:startColor="#3DF5A623"
                android:type="radial" />
        </shape>
    </item>

    <!-- Bottom Secondary Subtle Glow: Gentle cool depth near action button area -->
    <item
        android:bottom="-180dp"
        android:left="-100dp"
        android:right="-100dp"
        android:top="450dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00F7F6F3"
                android:gradientRadius="340dp"
                android:startColor="#183B82F6"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
