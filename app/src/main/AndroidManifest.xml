<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AttendCollegeAttendanceTracker">




        <activity
            android:name=".screens.privacy.PrivacyPolicyActivity"
            android:exported="false" />
        <activity
            android:name=".screens.terms.TermsActivity"
            android:exported="false" />
        <activity
            android:name=".screens.subject.AdditionalSubjectInfoActivity"
            android:exported="false" />
        <activity
            android:name=".screens.splash.EntryActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@style/Theme.Material3Expressive.DynamicColors.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".screens.auth.LoginActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:theme="@style/Theme.Material3Expressive.DynamicColors.Light.NoActionBar" />
        <activity
            android:name=".screens.onBoarding.OnboardingActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:theme="@style/Theme.Material3Expressive.DynamicColors.Light.NoActionBar" />
        <activity
            android:name=".screens.setting.SettingActivity"
            android:exported="false" />
        <activity
            android:name=".screens.holiday.HolidayActivity"
            android:exported="false" />
        <activity
            android:name=".screens.timeTable.TimeTableActivity"
            android:exported="false" />
        <activity
            android:name=".screens.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".screens.home.HomeActivity"
            android:exported="true" />
        <activity
            android:name=".screens.subject.SubjectInfoActivity"
            android:exported="false" />
        <activity
            android:name=".screens.analytics.AnalyticsActivity"
            android:exported="false" />
        <activity
            android:name=".screens.registration.SemesterRegistrationActivity"
            android:exported="false" />
        <activity
            android:name=".screens.fees.FeesPaymentActivity"
            android:exported="false" />
        <activity
            android:name=".screens.webmail.WebmailActivity"
            android:exported="false" />
        <activity
            android:name=".screens.webmail.WebmailDetailActivity"
            android:exported="false" />

        <!-- Quick Attendance AppWidget -->
        <receiver
            android:name=".widget.AttendanceWidgetProvider"
            android:exported="true"
            android:label="@string/attendance_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.redcodersgroup.attend_collegeattendancetracker.ACTION_MARK_ATTENDANCE" />
                <action android:name="com.redcodersgroup.attend_collegeattendancetracker.ACTION_MARK_ALL_PRESENT" />
                <action android:name="com.redcodersgroup.attend_collegeattendancetracker.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info" />
        </receiver>

        <!-- Notification Receivers -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.DailyAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".widget.AttendanceWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>